   A: [speaker A's speech]

Return the transcript as plain, unedited text."""


plugin_instance = None
_patched = False
_socks_lock = threading.local()
DEFAULT_CONNECTION_MODE = 3
DEFAULT_DNS_SERVER = "dns.dns-ai.ru"

def _recv_all(sock, n):
    data = b""
    while len(data) < n:
        packet = sock.recv(n - len(data))
        if not packet:
            break
        data += packet
    return data

def _create_direct_connection(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None, socket_options=None):
    """Open a TCP socket without calling socket/urllib3 create_connection hooks.

    GreenPass and this plugin both patch those helpers. Using either patched
    helper as the recursion escape hatch can send the connection straight back
    through the other plugin. Keep DNS lookup (including our custom DNS hook),
    but perform the actual connect with socket.socket directly.
    """
    host, port = address[:2]
    last_error = None
    for family, socktype, proto, _canonname, sockaddr in socket.getaddrinfo(
        host, port, 0, socket.SOCK_STREAM
    ):
        sock = None
        try:
            sock = socket.socket(family, socktype, proto)
            for option in socket_options or ():
                sock.setsockopt(*option)
            if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
                sock.settimeout(timeout)
            if source_address:
                sock.bind(source_address)
            sock.connect(sockaddr)
            return sock
        except OSError as exc:
            last_error = exc
            if sock is not None:
                try:
                    sock.close()
                except Exception:
                    pass
    if last_error is not None:
        raise last_error
    raise OSError("getaddrinfo returned no addresses for %r" % (address,))

def get_requests_proxies():
    # SOCKS5 cannot be passed directly into requests.proxies without PySocks (which is missing on Android).
    # All connections for GreenPass (mode 1) and SOCKS5 (mode 2) are handled natively by socks5_create_connection.
    return None

def socks5_create_connection(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None, socket_options=None):
    global plugin_instance
    if getattr(_socks_lock, "active", False):
        return _create_direct_connection(address, timeout, source_address, socket_options)

    if plugin_instance:
        conn_mode = plugin_instance.get_setting("connection_mode", DEFAULT_CONNECTION_MODE)
        
        proxy_host = ""
        proxy_port_val = ""
        username = ""
        password = ""
        
        if conn_mode == 1:
            try:
                api = sys.modules.get("greenpass_proxy_api")
                if api is None:
                    try:
                        import greenpass_proxy_api as api
                    except Exception:
                        api = None

                ep = None
                gp_plugin = getattr(api, "_plugin", None) if api else None
                if api:
                    if hasattr(api, "endpoint"):
                        try:
                            ep = api.endpoint()
                        except:
                            ep = None
                    if not ep or not ep.get("host") or not ep.get("port"):
                        if gp_plugin:
                            try:
                                if hasattr(gp_plugin, "_greenpass_socks_endpoint"):
                                    ep = gp_plugin._greenpass_socks_endpoint()
                                elif hasattr(gp_plugin, "_vless_port") and gp_plugin._vless_port:
                                    ep = {
                                        "host": "127.0.0.1",
                                        "port": int(gp_plugin._vless_port),
                                        "username": getattr(gp_plugin, "_vless_socks_username", ""),
                                        "password": getattr(gp_plugin, "_vless_socks_password", "")
                                    }
                            except:
                                pass

                if ep and ep.get("host") and ep.get("port"):
                    ep_host = str(ep["host"])
                    try:
                        ep_port = int(ep["port"])
                    except (ValueError, TypeError):
                        ep_port = 0

                    target_host = address[0] if isinstance(address, (tuple, list)) and len(address) > 0 else ""
                    target_port = int(address[1]) if isinstance(address, (tuple, list)) and len(address) > 1 else 0

                    # Direct bypass if connecting to the proxy itself to prevent recursion deadlock
                    if (target_host == ep_host or (target_host in ("127.0.0.1", "localhost", "::1") and ep_host in ("127.0.0.1", "localhost", "::1"))) and target_port == ep_port:
                        return _create_direct_connection(address, timeout, source_address, socket_options)

                    if gp_plugin and hasattr(gp_plugin, "_plugin_proxy_socks_create_connection"):
                        _socks_lock.active = True
                        try:
                            sock = gp_plugin._plugin_proxy_socks_create_connection(ep, address, timeout, source_address)
                            for option in socket_options or ():
                                sock.setsockopt(*option)
                            return sock
                        finally:
                            _socks_lock.active = False
                    proxy_host = ep_host
                    proxy_port_val = str(ep_port)
                    username = str(ep.get("username", "") or "")
                    password = str(ep.get("password", "") or "")
                else:
                    err_msg = "GreenPass не готов"
                    if api and hasattr(api, "status"):
                        try:
                            st = api.status()
                            if st.get("error"):
                                err_msg = f"GreenPass: {st['error']}"
                        except:
                            pass
                    raise RuntimeError(f"{err_msg}. Убедитесь, что в GreenPass подключен рабочий узел (VLESS / AmneziaWG, не TGWS).")
            except Exception as e:
                log(f"[TRANSCRIBER] Error in GreenPass SOCKS connection: {e}")
                raise
        elif conn_mode == 2:
            proxy_host = plugin_instance.get_setting("proxy_host", "").strip()
            proxy_port_val = plugin_instance.get_setting("proxy_port", "").strip()
            username = plugin_instance.get_setting("proxy_user", "").strip()
            password = plugin_instance.get_setting("proxy_pass", "").strip()
            
        try:
            proxy_port = int(proxy_port_val) if proxy_port_val else 0
        except ValueError:
            proxy_port = 0
            
        if proxy_host and proxy_port:
            host = address[0] if isinstance(address, (tuple, list)) and len(address) > 0 else ""
            port = int(address[1]) if isinstance(address, (tuple, list)) and len(address) > 1 else 0
            
            # If the request is to the proxy itself, use original connection
            if (host == proxy_host or (host in ("127.0.0.1", "localhost", "::1") and proxy_host in ("127.0.0.1", "localhost", "::1"))) and port == proxy_port:
                return _create_direct_connection(address, timeout, source_address, socket_options)
                
            try:
                addrs = socket.getaddrinfo(proxy_host, proxy_port, socket.AF_UNSPEC, socket.SOCK_STREAM)
            except socket.gaierror as e:
                raise RuntimeError(f"Failed to resolve proxy host {proxy_host}: {e}")
                
            if not addrs:
                raise RuntimeError(f"No address found for proxy host {proxy_host}")
                
            sock = None
            last_err = None
            for af, socktype, proto, canonname, sa in addrs:
                try:
                    sock = socket.socket(af, socktype, proto)
                    if socket_options:
                        for opt in socket_options:
                            sock.setsockopt(*opt)
                    if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
                        sock.settimeout(timeout)
                    if source_address:
                        sock.bind(source_address)
                    sock.connect(sa)
                    break
                except socket.error as e:
                    last_err = e
                    if sock:
                        sock.close()
                        sock = None
            
            if sock is None:
                if last_err:
                    raise last_err
                raise RuntimeError(f"Failed to connect to proxy {proxy_host}:{proxy_port}")
                
            try:
                if username or password:
                    sock.sendall(b"\x05\x01\x02")
                    reply = _recv_all(sock, 2)
                    if reply != b"\x05\x02":
                        raise RuntimeError("SOCKS5 auth method rejected by proxy")
                    user_bytes = username.encode('utf-8')[:255]
                    pass_bytes = password.encode('utf-8')[:255]
                    auth_req = b"\x01" + bytes([len(user_bytes)]) + user_bytes + bytes([len(pass_bytes)]) + pass_bytes
                    sock.sendall(auth_req)
                    
                    auth_resp = _recv_all(sock, 2)
                    if len(auth_resp) < 2 or auth_resp[1] != 0:
                        raise RuntimeError("SOCKS5 authentication failed")
                else:
                    sock.sendall(b"\x05\x01\x00")
                    reply = _recv_all(sock, 2)
                    if reply != b"\x05\x00":
                        raise RuntimeError("SOCKS5 no-auth rejected by proxy")
                    
                try:
                    addr_bytes = socket.inet_pton(socket.AF_INET, str(host))
                    addr_type = 1
                except (socket.error, AttributeError):
                    try:
                        addr_bytes = socket.inet_pton(socket.AF_INET6, str(host))
                        addr_type = 4
                    except (socket.error, AttributeError):
                        addr_type = 3
                        host_bytes = str(host).encode('idna')[:255]
                        addr_bytes = bytes([len(host_bytes)]) + host_bytes
                        
                req = b"\x05\x01\x00" + bytes([addr_type]) + addr_bytes + struct.pack("!H", int(port) & 0xFFFF)
                sock.sendall(req)
                
                resp = _recv_all(sock, 4)
                if len(resp) < 4 or resp[1] != 0:
                    status = resp[1] if len(resp) >= 2 else -1
                    raise RuntimeError(f"SOCKS5 request failed: status 0x{status:02x}")
                    
                atype = resp[3]
                if atype == 1:
                    _recv_all(sock, 4)
                elif atype == 3:
                    len_byte = _recv_all(sock, 1)
                    if not len_byte:
                        raise RuntimeError("SOCKS5 response truncated")
                    _recv_all(sock, len_byte[0])
                elif atype == 4:
                    _recv_all(sock, 16)
                else:
                    raise RuntimeError(f"SOCKS5 response has unknown address type: {atype}")
                _recv_all(sock, 2)
                    
                return sock
            except Exception as e:
                sock.close()
                raise socket.error(f"SOCKS5 proxy connection failed: {e}")
                
    return _create_direct_connection(address, timeout, source_address, socket_options)

_orig_getaddrinfo = socket.getaddrinfo
_dns_patched = False

def _resolve_dns_udp(hostname, dns_ip):
    try:
        known = {
            "xbox-dns.ru": "77.220.180.180",
            "dns.malw.link": "77.220.180.180",
            "dns.dns-ai.ru": "192.144.59.14",
        }
        dns_ip = known.get(dns_ip.lower(), dns_ip).strip()
        if not dns_ip:
            dns_ip = "77.220.180.180"
            
        parts = dns_ip.split(".")
        if not (len(parts) == 4 and all(p.isdigit() and 0 <= int(p) <= 255 for p in parts)):
            try:
                res = _orig_getaddrinfo(dns_ip, 53, socket.AF_INET, socket.SOCK_DGRAM)
                if res:
                    dns_ip = res[0][4][0]
            except Exception:
                dns_ip = "77.220.180.180"

        packet = struct.pack(">HHHHHH", 0x1234, 0x0100, 1, 0, 0, 0)
        for part in hostname.split("."):
            part_bytes = part.encode('utf-8')
            packet += struct.pack("B", len(part_bytes)) + part_bytes
        packet += b"\x00" + struct.pack(">HH", 1, 1)
        
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.settimeout(2.5)
        sock.sendto(packet, (dns_ip, 53))
        
        data, _ = sock.recvfrom(512)
        ancount = struct.unpack(">H", data[6:8])[0]
        if ancount == 0:
            return []
        
        idx = 12
        qdcount = struct.unpack(">H", data[4:6])[0]
        for _ in range(qdcount):
            while idx < len(data) and data[idx] != 0:
                idx += 1
            idx += 5
            
        ips = []
        for _ in range(ancount):
            if idx >= len(data):
                break
            if (data[idx] & 0xC0) == 0xC0:
                idx += 2
            else:
                while idx < len(data) and data[idx] != 0:
                    idx += 1
                idx += 1
            
            if idx + 10 > len(data):
                break
            atype, aclass, ttl, rdlength = struct.unpack(">HHIH", data[idx:idx+10])
            idx += 10
            rdata = data[idx:idx+rdlength]
            idx += rdlength
            
            if atype == 1 and rdlength == 4:
                ips.append(socket.inet_ntoa(rdata))
        return ips
    except Exception:
        return []

def _resolve_dns_dot(hostname, dns_host):
    server_name = str(dns_host or "").strip()
    if not server_name:
        return []

    # DNS-AI intentionally does not listen on plaintext DNS/53. Bootstrap its
    # encrypted resolver using the published IPs, but keep the hostname for
    # SNI and certificate validation.
    known = {
        "xbox-dns.ru": ("77.220.180.180",),
        "dns.malw.link": ("77.220.180.180",),
        "dns.dns-ai.ru": ("192.144.59.14", "186.246.49.127"),
    }
    addresses = known.get(server_name.lower())
    if addresses is None:
        try:
            socket.inet_pton(socket.AF_INET, server_name)
            addresses = (server_name,)
        except OSError:
            try:
                addresses = tuple(
                    dict.fromkeys(
                        result[4][0]
                        for result in _orig_getaddrinfo(
                            server_name, 853, socket.AF_INET, socket.SOCK_STREAM
                        )
                    )
                )
            except Exception:
                return []

    try:
        ctx = ssl.create_default_context(cafile=requests.certs.where())
    except Exception:
        ctx = ssl.create_default_context()

    query_id = 0x1234
    header = struct.pack("!HHHHHH", query_id, 0x0100, 1, 0, 0, 0)
    try:
        labels = hostname.rstrip(".").split(".")
        if not hostname or any(not label or len(label.encode("idna")) > 63 for label in labels):
            return []
        qname = b"".join(bytes([len(label.encode("idna"))]) + label.encode("idna") for label in labels) + b"\x00"
        question = qname + struct.pack("!HH", 1, 1)
        message = header + question
        framed_message = struct.pack("!H", len(message)) + message
    except Exception:
        return []

    for dns_ip in addresses:
        raw_sock = None
        try:
            # Bypass both plugins' create_connection monkey-patches for the
            # resolver bootstrap connection. This is a direct DoT request.
            raw_sock = _create_direct_connection((dns_ip, 853), timeout=3.5)
            with ctx.wrap_socket(raw_sock, server_hostname=server_name) as tls_sock:
                raw_sock = None  # wrap_socket owns and closes the raw socket
                tls_sock.sendall(framed_message)
                length_prefix = _recv_all(tls_sock, 2)
                if len(length_prefix) != 2:
                    continue
                response_length = struct.unpack("!H", length_prefix)[0]
                response = _recv_all(tls_sock, response_length)

            if len(response) < 12:
                continue
            response_id, response_flags, qdcount, ancount, _, _ = struct.unpack("!HHHHHH", response[:12])
            if response_id != query_id or not (response_flags & 0x8000) or (response_flags & 0x000F):
                continue

            index = 12
            for _ in range(qdcount):
                while index < len(response) and response[index] != 0:
                    if response[index] & 0xC0 == 0xC0:
                        index += 2
                        break
                    index += 1 + response[index]
                else:
                    index += 1
                index += 4

            ips = []
            for _ in range(ancount):
                if index >= len(response):
                    break
                if response[index] & 0xC0 == 0xC0:
                    index += 2
                else:
                    while index < len(response) and response[index] != 0:
                        index += 1 + response[index]
                    index += 1
                if index + 10 > len(response):
                    break
                rtype, rclass, _, rdlength = struct.unpack("!HHIH", response[index:index + 10])
                index += 10
                rdata = response[index:index + rdlength]
                index += rdlength
                if rtype == 1 and rclass == 1 and rdlength == 4:
                    ips.append(socket.inet_ntoa(rdata))
            if ips:
                return ips
        except Exception:
            pass
        finally:
            if raw_sock is not None:
                try:
                    raw_sock.close()
                except Exception:
                    pass
    return []

_dns_lock = threading.local()

def _resolve_dns_doh(hostname):
    try:
        url = f"https://dns.google/resolve?name={hostname}&type=A"
        r = requests.get(url, timeout=3)
        if r.status_code == 200:
            data = r.json()
            ips = []
            for ans in data.get("Answer", []):
                if ans.get("type") == 1 and ans.get("data"):
                    ips.append(ans["data"])
            if ips:
                return ips
    except Exception:
        pass
    return []

def resolve_dns_custom(hostname, dns_server):
    dns_server_str = str(dns_server or "").strip()
    if dns_server_str.lower() == "dns.dns-ai.ru":
        # DNS-AI only serves encrypted DNS; its UDP/53 endpoint is closed.
        return _resolve_dns_dot(hostname, dns_server_str)
    if any(c.isalpha() for c in dns_server_str):
        ips = _resolve_dns_dot(hostname, dns_server_str)
        if ips:
            return ips
    ips = _resolve_dns_udp(hostname, dns_server_str)
    if ips:
        return ips
    ips = _resolve_dns_dot(hostname, dns_server_str)
    if ips:
        return ips
    return _resolve_dns_doh(hostname)

def dns_getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
    global plugin_instance
    if getattr(_dns_lock, "active", False):
        return _orig_getaddrinfo(host, port, family, type, proto, flags)

    if plugin_instance and plugin_instance.get_setting("connection_mode", DEFAULT_CONNECTION_MODE) == 3:
        host_str = str(host or "").strip()
        bypass_hosts = ("localhost", "127.0.0.1", "::1", "dns.google", "cloudflare-dns.com", "one.one.one.one", "77.220.180.180", "xbox-dns.ru", "dns.malw.link", "dns.dns-ai.ru")
        is_ip_literal = False
        for address_family in (socket.AF_INET, socket.AF_INET6):
            try:
                socket.inet_pton(address_family, host_str)
                is_ip_literal = True
                break
            except (OSError, TypeError):
                pass
        if host_str and not is_ip_literal and host_str.lower() not in bypass_hosts:
            dns_server = str(plugin_instance.get_setting("dns_server", DEFAULT_DNS_SERVER) or DEFAULT_DNS_SERVER).strip()
            _dns_lock.active = True
            try:
                ips = resolve_dns_custom(host_str, dns_server)
                if ips:
                    return _orig_getaddrinfo(ips[0], port, family, type, proto, flags)
            except Exception as e:
                log(f"[TRANSCRIBER] Custom DNS resolve error: {e}")
            finally:
                _dns_lock.active = False

    return _orig_getaddrinfo(host, port, family, type, proto, flags)

def apply_socks5_patch():
    global _patched, _dns_patched
    if not _dns_patched:
        socket.getaddrinfo = dns_getaddrinfo
        _dns_patched = True
    if not _patched:
        socket.create_connection = socks5_create_connection

        packages_to_patch = ["urllib3.util.connection", "urllib3.connection", "urllib3.util"]
        try:
            import requests.packages.urllib3.util.connection
            packages_to_patch.append("requests.packages.urllib3.util.connection")
        except ImportError:
            pass
        try:
            import requests.packages.urllib3.connection
            packages_to_patch.append("requests.packages.urllib3.connection")
        except ImportError:
            pass
            
        for pkg_name in packages_to_patch:
            if pkg_name in sys.modules:
                sys.modules[pkg_name].create_connection = socks5_create_connection
            else:
                try:
                    __import__(pkg_name)
                    if pkg_name in sys.modules:
                        sys.modules[pkg_name].create_connection = socks5_create_connection
                except ImportError:
                    pass

        try:
            import urllib3.connection as urllib3_base_conn
            if hasattr(urllib3_base_conn, "HTTPConnection"):
                def _patched_http_new_conn(self):
                    host = getattr(self, "_dns_host", self.host)
                    extra_kw = {}
                    if getattr(self, "source_address", None):
                        extra_kw["source_address"] = self.source_address
                    if getattr(self, "socket_options", None):
                        extra_kw["socket_options"] = self.socket_options
                    return socks5_create_connection((host, self.port), self.timeout, **extra_kw)
                urllib3_base_conn.HTTPConnection._new_conn = _patched_http_new_conn
        except Exception:
            pass

        _patched = True

apply_socks5_patch()


