def get_error_raw_res_id():
    try:
        context = get_last_fragment().getParentActivity()
        return context.getResources().getIdentifier("error", "raw", context.getPackageName())
    except:
        try:
            from org.telegram.messenger import R
            return R.raw.error
        except:
            return 0
