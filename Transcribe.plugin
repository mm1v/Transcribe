DEFAULT_PROMPT = """Please produce a verbatim transcript of the audio. Follow these instructions:

1. Transcribe exactly what is spoken, word for word.
2. Include all filler words (e.g., um, uh, you know, like), hesitations, repeated words, and any self-corrections.
3. Do not correct grammar or wording — leave speech errors unchanged.
4. If you don't detect any speech, return "..." and nothing else.

Return the transcript as plain, unedited text."""
DEFAULT_PROMPT_DIARIZATION = """Please produce a verbatim transcript of the audio. Follow these instructions:

1. Transcribe exactly what is spoken, word for word.
2. Include all filler words (e.g., um, uh, you know, like), hesitations, repeated words, and any self-corrections.
3. Do not correct grammar or wording — leave speech errors unchanged.
4. If you don't detect any speech, return "..." and nothing else.
5. If the audio contains a dialogue between multiple speakers, label each speaker with a letter (A, B, C, etc.) and format each speaker's utterance on a new line like this:
   A: [speaker A's speech]
   B: [speaker B's speech]
   A: [speaker A's speech]

Return the transcript as plain, unedited text."""


plugin_instance = None
_orig_create_connection = None
_patched = False

def _recv_all(sock, n):
    data = b""
    while len(data) < n:
        packet = sock.recv(n - len(data))
        if not packet:
            break
        data += packet
    return data

def socks5_create_connection(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None, socket_options=None):
    global plugin_instance, _orig_create_connection
    if plugin_instance and (plugin_instance.get_setting("proxy_enabled", False) or plugin_instance.get_setting("proxy_use_greenpass", True)):
        proxy_host = ""
        proxy_port_val = ""
        username = ""
        password = ""
        
        if plugin_instance.get_setting("proxy_use_greenpass", True):
            try:
                import greenpass_proxy_api
                if greenpass_proxy_api.is_available():
                    ep = greenpass_proxy_api.endpoint()
                    if ep:
                        proxy_host = ep.get("host", "")
                        proxy_port_val = str(ep.get("port", ""))
                        username = ep.get("username", "")
                        password = ep.get("password", "")
            except Exception:
                pass
                
        if not proxy_host:
            proxy_host = plugin_instance.get_setting("proxy_host", "")
            proxy_port_val = plugin_instance.get_setting("proxy_port", "")
            username = plugin_instance.get_setting("proxy_user", "")
            password = plugin_instance.get_setting("proxy_pass", "")
            
        try:
            proxy_port = int(proxy_port_val) if proxy_port_val else 0
        except ValueError:
            proxy_port = 0
            
        if proxy_host and proxy_port:
            host, port = address[:2]
            
            # If the request is to the proxy itself, use original connection
            if host == proxy_host and port == proxy_port:
                if _orig_create_connection:
                    try:
                        return _orig_create_connection(address, timeout, source_address, socket_options)
                    except TypeError:
                        return _orig_create_connection(address, timeout, source_address)
                else:
                    raise RuntimeError("Original create_connection is not saved")
                
            try:
                addrs = socket.getaddrinfo(proxy_host, proxy_port, socket.AF_UNSPEC, socket.SOCK_STREAM)
            except socket.gaierror as e:
                raise RuntimeError(f"Failed to resolve proxy host {proxy_host}: {e}")
                
            if not addrs:
                raise RuntimeError(f"No address found for proxy host {proxy_host}")
                
            sock = None
            last_err = None
            for af, socktype, proto, canonname, sa in addrs:
                try:
                    sock = socket.socket(af, socktype, proto)
                    if socket_options:
                        for opt in socket_options:
                            sock.setsockopt(*opt)
                    if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
                        sock.settimeout(timeout)
                    if source_address:
                        sock.bind(source_address)
                    sock.connect(sa)
                    break
                except socket.error as e:
                    last_err = e
                    if sock:
                        sock.close()
                        sock = None
            
            if sock is None:
                if last_err:
                    raise last_err
                raise RuntimeError(f"Failed to connect to proxy {proxy_host}:{proxy_port}")
                
            try:
                if username or password:
                    sock.sendall(b"\x05\x02\x00\x02")
                else:
                    sock.sendall(b"\x05\x01\x00")
                    
                resp = _recv_all(sock, 2)
                if len(resp) < 2 or resp[0] != 5:
                    raise RuntimeError("Invalid SOCKS5 response from proxy")
                    
                method = resp[1]
                if method == 0x02:
                    user_bytes = username.encode('utf-8')
                    pass_bytes = password.encode('utf-8')
                    auth_req = b"\x01" + bytes([len(user_bytes)]) + user_bytes + bytes([len(pass_bytes)]) + pass_bytes
                    sock.sendall(auth_req)
                    
                    auth_resp = _recv_all(sock, 2)
                    if len(auth_resp) < 2 or auth_resp[0] != 1 or auth_resp[1] != 0:
                        raise RuntimeError("SOCKS5 authentication failed")
                elif method == 0x00:
                    pass
                elif method == 0xFF:
                    raise RuntimeError("SOCKS5 proxy requires authentication")
                else:
                    raise RuntimeError(f"Unsupported SOCKS5 auth method: {method}")
                    
                try:
                    ipv4_bytes = socket.inet_aton(host)
                    addr_type = 1
                    addr_bytes = ipv4_bytes
                except socket.error:
                    try:
                        if hasattr(socket, "inet_pton"):
                            ipv6_bytes = socket.inet_pton(socket.AF_INET6, host)
                            addr_type = 4
                            addr_bytes = ipv6_bytes
                        else:
                            raise socket.error
                    except socket.error:
                        addr_type = 3
                        host_bytes = host.encode('utf-8')
                        if len(host_bytes) > 255:
                            raise ValueError(f"Hostname too long: {host}")
                        addr_bytes = bytes([len(host_bytes)]) + host_bytes
                        
                req = b"\x05\x01\x00" + bytes([addr_type]) + addr_bytes + struct.pack("!H", port)
                sock.sendall(req)
                
                resp = _recv_all(sock, 4)
                if len(resp) < 4 or resp[0] != 5 or resp[1] != 0:
                    status = resp[1] if len(resp) >= 2 else -1
                    errors = {
                        1: "general SOCKS server failure",
                        2: "connection not allowed by ruleset",
                        3: "Network unreachable",
                        4: "Host unreachable",
                        5: "Connection refused",
                        6: "TTL expired",
                        7: "Command not supported",
                        8: "Address type not supported"
                    }
                    err_msg = errors.get(status, f"unknown error {status}")
                    raise RuntimeError(f"SOCKS5 request failed: {err_msg}")
                    
                atype = resp[3]
                if atype == 1:
                    _recv_all(sock, 6)
                elif atype == 3:
                    len_byte = _recv_all(sock, 1)
                    if not len_byte:
                        raise RuntimeError("SOCKS5 response truncated")
                    _recv_all(sock, len_byte[0] + 2)
                elif atype == 4:
                    _recv_all(sock, 18)
                else:
                    raise RuntimeError(f"SOCKS5 response has unknown address type: {atype}")
                    
                return sock
            except Exception as e:
                sock.close()
                raise socket.error(f"SOCKS5 proxy connection failed: {e}")
                
    if _orig_create_connection:
        try:
            return _orig_create_connection(address, timeout, source_address, socket_options)
        except TypeError:
            return _orig_create_connection(address, timeout, source_address)
    else:
        raise RuntimeError("Original create_connection is not saved")

_orig_getaddrinfo = socket.getaddrinfo
_dns_patched = False

def resolve_dns_custom(hostname, dns_ip):
    try:
        packet = struct.pack(">HHHHHH", 0x1234, 0x0100, 1, 0, 0, 0)
        for part in hostname.split("."):
            part_bytes = part.encode('utf-8')
            packet += struct.pack("B", len(part_bytes)) + part_bytes
        packet += struct.pack(">HH", 0x0000, 0x0001)
        
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.settimeout(3.0)
        sock.sendto(packet, (dns_ip, 53))
        
        data, _ = sock.recvfrom(512)
        ancount = struct.unpack(">H", data[6:8])[0]
        if ancount == 0:
            return []
        
        idx = 12
        qdcount = struct.unpack(">H", data[4:6])[0]
        for _ in range(qdcount):
            while data[idx] != 0:
                idx += 1
            idx += 5
            
        ips = []
        for _ in range(ancount):
            if (data[idx] & 0xC0) == 0xC0:
                idx += 2
            else:
                while data[idx] != 0:
                    idx += 1
                idx += 1
            
            atype, aclass, ttl, rdlength = struct.unpack(">HHIH", data[idx:idx+10])
            idx += 10
            rdata = data[idx:idx+rdlength]
            idx += rdlength
            
            if atype == 1 and rdlength == 4:
                ips.append(socket.inet_ntoa(rdata))
        return ips
    except Exception:
        return []

def dns_getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
    global plugin_instance
    if plugin_instance and plugin_instance.get_setting("dns_enabled", False):
        dns_server = plugin_instance.get_setting("dns_server", "").strip()
        if dns_server and not host.replace(".", "").isdigit() and host not in ("localhost", "127.0.0.1", "::1"):
            ips = resolve_dns_custom(host, dns_server)
            if ips:
                return _orig_getaddrinfo(ips[0], port, family, type, proto, flags)
    return _orig_getaddrinfo(host, port, family, type, proto, flags)

def apply_socks5_patch():
    global _patched, _orig_create_connection, _dns_patched
    if not _dns_patched:
        socket.getaddrinfo = dns_getaddrinfo
        _dns_patched = True
    if not _patched:
        try:
            import urllib3.util.connection
            _orig_create_connection = urllib3.util.connection.create_connection
        except Exception:
            try:
                import urllib3.connection
                _orig_create_connection = urllib3.connection.create_connection
            except Exception:
                pass
                
        if not _orig_create_connection:
            _orig_create_connection = socket.create_connection

        packages_to_patch = ["urllib3.util.connection", "urllib3.connection"]
        try:
            import requests.packages.urllib3.util.connection
            packages_to_patch.append("requests.packages.urllib3.util.connection")
        except ImportError:
            pass
        try:
            import requests.packages.urllib3.connection
            packages_to_patch.append("requests.packages.urllib3.connection")
        except ImportError:
            pass
            
        for pkg_name in packages_to_patch:
            if pkg_name in sys.modules:
                sys.modules[pkg_name].create_connection = socks5_create_connection
            else:
                try:
                    __import__(pkg_name)
                    sys.modules[pkg_name].create_connection = socks5_create_connection
                except ImportError:
                    pass
        _patched = True


